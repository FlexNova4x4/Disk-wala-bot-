# Required: create a bot with @BotFather and paste its token here.
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Required: your numeric Telegram user ID. Never share it publicly.
OWNER_ID=123456789

# Optional: initial destination group/supergroup ID (example: -1001234567890).
# You can also change it later with /setgroup -1001234567890
DESTINATION_CHAT_ID=

# Required only when using docker-compose.yml for 2 GB uploads.
# Get these from https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=PASTE_API_HASH_HERE

# For Docker Compose, keep this as the service URL below.
# For a non-Docker install, use your Local Bot API server's reachable URL.
LOCAL_BOT_API_URL=http://telegram-bot-api:8081

# Storage and performance
DATA_DIR=./data
MAX_FILE_SIZE_BYTES=2000000000
UPDATE_WORKERS=32
